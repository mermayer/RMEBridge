{
  "openapi": "3.0.3",
  "info": {
    "title": "RME Bridge local API",
    "version": "1.0.0-test",
    "description": "Unauthenticated API for a trusted LAN only. Non-EQ parameter writes require a current DAC readback and availability for the MIDI-identified model. HTTP 202 is not a DAC confirmation."
  },
  "servers": [{"url": "http://{bridgeIp}", "variables": {"bridgeIp": {"default": "192.0.2.55"}}}],
  "paths": {
    "/api/v1": {
      "get": {"summary": "Discover API v1", "responses": {"200": {"description": "Version, access warning and links", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Discovery"}}}}}}
    },
    "/api/v1/status": {
      "get": {"summary": "Read current Bridge and DAC status", "responses": {"200": {"description": "Current readback or null for unknown values", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}}}}
    },
    "/api/v1/time": {
      "get": {"summary": "Read SNTP synchronization state and UTC time", "responses": {"200": {"description": "Unix seconds are null before synchronization", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Time"}}}}}}
    },
    "/api/v1/capabilities": {
      "get": {"summary": "Read model-specific capabilities and lock reasons", "responses": {"200": {"description": "Dynamic capability map", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Capabilities"}}}}}}
    },
    "/api/v1/settings": {
      "get": {"summary": "Read saved Bridge settings", "responses": {"200": {"description": "Saved settings", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settings"}}}}}}
    },
    "/api/v1/settings/language": {
      "put": {"summary": "Save website language", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["language"], "properties": {"language": {"type": "string", "enum": ["de", "en"]}}}}}}, "responses": {"200": {"description": "Saved", "content": {"application/json": {"schema": {"type": "object", "properties": {"language": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/settings/accent-color": {
      "put": {"summary": "Save website accent colour from the RME Bridge palette", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["accentColor"], "properties": {"accentColor": {"$ref": "#/components/schemas/AccentColor"}}}}}}, "responses": {"200": {"description": "Saved preferences", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Preferences"}}}}, "400": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/settings/model": {
      "put": {"summary": "Save model probe and offline-IR preference, never spoof DAC identity", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["model"], "properties": {"model": {"type": "integer", "enum": [0, 113, 114, 115]}}}}}}, "responses": {"200": {"description": "Saved", "content": {"application/json": {"schema": {"type": "object", "properties": {"saved": {"type": "boolean"}, "modelPreference": {"type": "integer"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/settings/target": {
      "put": {"summary": "Save addressed output; does not switch the physical DAC output", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["target"], "properties": {"target": {"$ref": "#/components/schemas/Target"}}}}}}, "responses": {"200": {"description": "Saved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Saved"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/output/toggle": {
      "post": {
        "summary": "Trigger the physical Phones/Line toggle on a verified ADI-2 DAC FS",
        "description": "Momentary MIDI index-63 trigger. Requires the DAC's Mute Line toggle mode and both headphone levels at or below -60 dB. The current active output and USB epoch are mandatory stale-state guards. HTTP 202 is not confirmation; poll Location for an observed active-output code change. The endpoint does not change selectedTarget; the Bridge website follows the confirmed output separately.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["expectedActiveOutputCode", "usbEpoch"],
          "properties": {"expectedActiveOutputCode": {"type": "integer", "enum": [0, 1, 2]}, "usbEpoch": {"type": "integer", "minimum": 0}}
        }}}},
        "responses": {"202": {"description": "Queued; poll operation for DAC confirmation", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Accepted"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/network": {
      "get": {"summary": "Read Wi-Fi status without credentials", "responses": {"200": {"description": "Network status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Network"}}}}}},
      "put": {"summary": "Save home Wi-Fi credentials from the protected setup AP only", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["ssid", "password"], "properties": {"ssid": {"type": "string"}, "password": {"type": "string", "format": "password"}}}}}}, "responses": {"200": {"description": "Saved; password never echoed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Saved"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/volume": {
      "put": {"summary": "Queue one bounded absolute volume step for the selected output", "description": "valueTenths and expectedTenths are tenths of a dB. Current limits: -1145..60, multiple of 5, at most +10 or -30 per command. Poll Location for DAC confirmation.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["target", "expectedTenths", "valueTenths"], "properties": {"target": {"$ref": "#/components/schemas/Target"}, "expectedTenths": {"type": "integer"}, "valueTenths": {"type": "integer"}}}}}}, "responses": {"202": {"description": "Queued, not yet confirmed", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Accepted"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/auto-dark": {
      "put": {"summary": "Queue AutoDark on/off", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}}}, "responses": {"202": {"description": "Queued, not yet confirmed", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Accepted"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/parameters": {
      "get": {"summary": "Read confirmed non-EQ DAC parameters and model-specific bounds", "responses": {"200": {"description": "Current values only; includes all three output addresses when reported", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterSnapshot"}}}}}},
      "put": {"summary": "Queue one guarded non-EQ parameter change", "description": "Output writes must address selectedTarget. A 202 response means queued, not applied; poll Location and read the parameter again. risk in the readback marks possible signal-path or level changes but requires no separate confirmation.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterWrite"}}}}, "responses": {"202": {"description": "Queued, not yet confirmed", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Accepted"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/operations/{id}": {
      "get": {"summary": "Poll a DAC write by its operation ID", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "Pending, confirmed, or failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Operation"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/refresh": {
      "post": {"summary": "Queue a fresh DAC read request", "responses": {"202": {"description": "Read request queued; fetch status afterwards", "content": {"application/json": {"schema": {"type": "object", "properties": {"queued": {"type": "boolean"}}}}}}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/ir/power": {
      "post": {"summary": "Transmit IR Power; physical DAC power is not confirmed", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string", "enum": ["on", "off"]}}}}}}, "responses": {"200": {"description": "IR signal sent only", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IrReceipt"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/events": {
      "get": {"summary": "Read newest-first RTC event log", "responses": {"200": {"description": "Event records", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Events"}}}}}},
      "delete": {"summary": "Clear RTC event log", "responses": {"200": {"description": "Cleared", "content": {"application/json": {"schema": {"type": "object", "properties": {"cleared": {"type": "boolean"}}}}}}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/profiles": {
      "get": {"summary": "Read saved DAC profile library without changing the DAC", "responses": {"200": {"description": "Profiles", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileLibrary"}}}}}},
      "post": {"summary": "Capture DAC-confirmed AutoDark and output volume as a named profile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileCaptureRequest"}}}}, "responses": {"201": {"description": "Saved without changing the DAC", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Profile"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/profiles/backup": {
      "get": {"summary": "Export versioned profile-library backup", "responses": {"200": {"description": "Backup, without Wi-Fi credentials or Bridge preferences", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileBackup"}}}}}},
      "put": {"summary": "Validate and atomically replace profile library, without DAC writes", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileBackupImport"}}}}, "responses": {"200": {"description": "Replaced library", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileLibrary"}}}}, "400": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/profiles/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1, "maximum": 65535}}],
      "put": {"summary": "Recapture an existing profile from confirmed DAC state", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileCaptureRequest"}}}}, "responses": {"200": {"description": "Updated without DAC write", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Profile"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "Delete saved profile, without DAC write", "responses": {"200": {"description": "Deleted", "content": {"application/json": {"schema": {"type": "object", "properties": {"deleted": {"type": "boolean"}, "id": {"type": "integer"}}}}}}, "404": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "responses": {
      "Error": {"description": "Request rejected or unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Target": {"type": "integer", "enum": [3, 6, 9], "description": "Addressed output: Line Out, Phones 1/2, Phones 3/4 or IEM"},
      "Profile": {"type": "object", "required": ["id", "name", "modelId", "target", "autoDark", "volumeTenths"], "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 65535}, "name": {"type": "string", "description": "Unique name, 1–48 UTF-8 bytes"}, "modelId": {"type": "integer", "enum": [113]}, "target": {"$ref": "#/components/schemas/Target"}, "autoDark": {"type": "boolean"}, "volumeTenths": {"type": "integer", "minimum": -1145, "maximum": 60, "multipleOf": 5}}},
      "ProfileCaptureRequest": {"type": "object", "required": ["name", "target"], "properties": {"name": {"type": "string", "description": "Unique name, 1–48 UTF-8 bytes"}, "target": {"$ref": "#/components/schemas/Target"}}},
      "ProfileLibrary": {"type": "object", "required": ["format", "version", "maxProfiles", "volumeAppliedByDefault", "profiles"], "properties": {"format": {"type": "string", "enum": ["rme-bridge-profiles"]}, "version": {"type": "integer", "enum": [1]}, "maxProfiles": {"type": "integer", "enum": [8]}, "volumeAppliedByDefault": {"type": "boolean", "enum": [false]}, "profiles": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/Profile"}}}},
      "ProfileBackup": {"allOf": [{"$ref": "#/components/schemas/ProfileLibrary"}, {"type": "object", "properties": {"exportedAt": {"type": "integer", "nullable": true}}}]},
      "ProfileBackupImport": {"type": "object", "required": ["format", "version", "profiles", "confirmReplace"], "properties": {"format": {"type": "string", "enum": ["rme-bridge-profiles"]}, "version": {"type": "integer", "enum": [1]}, "profiles": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/Profile"}}, "confirmReplace": {"type": "boolean", "enum": [true]}, "exportedAt": {"type": "integer", "nullable": true}}},
      "AccentColor": {"type": "string", "enum": ["#5CE0E1", "#5BA8FF", "#A78BFA", "#F472B6", "#F87171", "#FB923C", "#F6B84A", "#C4D86B", "#65D58A"], "description": "Saved website-only accent colour"},
      "Preferences": {"type": "object", "required": ["language", "accentColor"], "properties": {"language": {"type": "string", "enum": ["de", "en"]}, "accentColor": {"$ref": "#/components/schemas/AccentColor"}}},
      "Time": {"type": "object", "required": ["apiVersion", "synchronized", "unixSeconds", "uptimeSeconds"], "properties": {"apiVersion": {"type": "integer", "enum": [1]}, "synchronized": {"type": "boolean"}, "unixSeconds": {"type": "integer", "nullable": true, "description": "UTC Unix seconds; null before first SNTP sync"}, "uptimeSeconds": {"type": "integer"}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}, "reason": {"type": "string", "enum": ["busy", "stale", "not_ready", "invalid", "unsafe_headphone_level"]}}},
      "Saved": {"type": "object", "required": ["saved"], "properties": {"saved": {"type": "boolean"}}},
      "Discovery": {"type": "object", "required": ["apiVersion", "experimental", "firmwareVersion", "access", "links"], "properties": {"apiVersion": {"type": "integer", "enum": [1]}, "experimental": {"type": "boolean"}, "firmwareVersion": {"type": "string"}, "access": {"type": "string"}, "links": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "Output": {"type": "object", "required": ["address", "name", "volumeTenths", "source", "loudness", "mute", "eqEnabled", "bassTrebleEnabled"], "properties": {"address": {"$ref": "#/components/schemas/Target"}, "name": {"type": "string"}, "volumeTenths": {"type": "integer", "nullable": true}, "source": {"type": "integer", "nullable": true}, "loudness": {"type": "integer", "nullable": true}, "mute": {"type": "integer", "nullable": true}, "eqEnabled": {"type": "boolean", "nullable": true, "description": "Reported MIDI EQ-enable setting, not proof of active DSP"}, "bassTrebleEnabled": {"type": "boolean", "nullable": true, "description": "Reported MIDI Bass/Treble-enable setting, not proof of active DSP"}}},
      "ParameterValue": {"type": "object", "required": ["address", "index", "value", "min", "max", "step", "risk", "writable"], "properties": {"address": {"type": "integer", "enum": [0, 3, 6, 9, 12]}, "index": {"type": "integer", "minimum": 0, "maximum": 63}, "value": {"type": "integer", "description": "Raw MIDI value, not a display unit"}, "min": {"type": "integer"}, "max": {"type": "integer"}, "step": {"type": "integer", "minimum": 1}, "risk": {"type": "boolean"}, "writable": {"type": "boolean", "description": "Write operation is available for this parameter and the current DAC state"}}},
      "ParameterSnapshot": {"type": "object", "required": ["apiVersion", "online", "modelId", "selectedTarget", "usbEpoch", "values"], "properties": {"apiVersion": {"type": "integer", "enum": [1]}, "online": {"type": "boolean"}, "modelId": {"type": "integer", "enum": [0, 113, 114, 115]}, "selectedTarget": {"$ref": "#/components/schemas/Target"}, "usbEpoch": {"type": "integer"}, "values": {"type": "array", "items": {"$ref": "#/components/schemas/ParameterValue"}}}},
      "ParameterWrite": {"type": "object", "required": ["address", "index", "value", "expected", "usbEpoch"], "properties": {"address": {"type": "integer", "enum": [0, 3, 6, 9, 12]}, "index": {"type": "integer", "minimum": 0, "maximum": 63}, "value": {"type": "integer"}, "expected": {"type": "integer", "description": "Current value from the same DAC readback"}, "usbEpoch": {"type": "integer", "description": "Connection epoch from the same snapshot"}}},
      "Status": {"type": "object", "required": ["apiVersion", "online", "clockSynchronized", "unixSeconds", "usb", "midi", "usbProblem", "vid", "pid", "busy", "unconfirmed", "deviceId", "model", "selectedTarget", "usbEpoch", "activeOutputCode", "outputToggleControl", "outputToggleReason", "irTransmitterReady", "irModelId", "irModelSource", "autoDark", "displayMode", "standby", "outputs"], "properties": {"apiVersion": {"type": "integer"}, "online": {"type": "boolean"}, "clockSynchronized": {"type": "boolean"}, "unixSeconds": {"type": "integer", "nullable": true}, "usb": {"type": "boolean"}, "midi": {"type": "boolean"}, "usbProblem": {"type": "integer"}, "vid": {"type": "integer"}, "pid": {"type": "integer"}, "busy": {"type": "boolean"}, "unconfirmed": {"type": "boolean"}, "deviceId": {"type": "integer", "nullable": true}, "model": {"type": "string", "nullable": true}, "selectedTarget": {"$ref": "#/components/schemas/Target"}, "usbEpoch": {"type": "integer", "description": "Incremented when the DAC USB connection is reset"}, "activeOutputCode": {"type": "integer", "nullable": true}, "outputToggleControl": {"type": "boolean"}, "outputToggleReason": {"type": "string", "nullable": true}, "irTransmitterReady": {"type": "boolean"}, "irModelId": {"type": "integer", "nullable": true}, "irModelSource": {"type": "integer", "enum": [0, 1, 2, 3]}, "autoDark": {"type": "integer", "nullable": true}, "displayMode": {"type": "integer", "nullable": true}, "standby": {"type": "integer", "nullable": true}, "outputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/Output"}}}},
      "Feature": {"type": "object", "required": ["readable", "writable", "reason"], "properties": {"readable": {"type": "boolean"}, "writable": {"type": "boolean"}, "reason": {"type": "string", "nullable": true}, "writePath": {"type": "string"}, "hardwareVerifiedForAll": {"type": "boolean"}}},
      "Capabilities": {"type": "object", "required": ["apiVersion", "detectedModelId", "selectedTarget", "features"], "properties": {"apiVersion": {"type": "integer"}, "detectedModelId": {"type": "integer", "nullable": true}, "selectedTarget": {"$ref": "#/components/schemas/Target"}, "features": {"type": "object", "required": ["volume", "autoDark", "source", "loudness", "mute", "displayMode", "standby", "parameters", "irPower", "outputToggle"], "properties": {"volume": {"$ref": "#/components/schemas/Feature"}, "autoDark": {"$ref": "#/components/schemas/Feature"}, "source": {"$ref": "#/components/schemas/Feature"}, "loudness": {"$ref": "#/components/schemas/Feature"}, "mute": {"$ref": "#/components/schemas/Feature"}, "displayMode": {"$ref": "#/components/schemas/Feature"}, "standby": {"$ref": "#/components/schemas/Feature"}, "parameters": {"$ref": "#/components/schemas/Feature"}, "irPower": {"$ref": "#/components/schemas/Feature"}, "outputToggle": {"$ref": "#/components/schemas/Feature"}}}}},
      "Settings": {"type": "object", "required": ["apiVersion", "language", "accentColor", "modelPreference", "selectedTarget"], "properties": {"apiVersion": {"type": "integer"}, "language": {"type": "string", "enum": ["de", "en"]}, "accentColor": {"$ref": "#/components/schemas/AccentColor"}, "modelPreference": {"type": "integer", "enum": [0, 113, 114, 115]}, "selectedTarget": {"$ref": "#/components/schemas/Target"}}},
      "Network": {"type": "object", "required": ["configured", "connected", "setupAp", "ssid", "ip", "apSsid", "hostname", "rssi"], "properties": {"configured": {"type": "boolean"}, "connected": {"type": "boolean"}, "setupAp": {"type": "boolean"}, "ssid": {"type": "string"}, "ip": {"type": "string"}, "apSsid": {"type": "string"}, "hostname": {"type": "string"}, "rssi": {"type": "integer"}}},
      "Accepted": {"type": "object", "required": ["operationId", "state", "statusUrl"], "properties": {"operationId": {"type": "integer"}, "state": {"type": "string", "enum": ["pending"]}, "statusUrl": {"type": "string"}}},
      "Operation": {"type": "object", "required": ["id", "state", "kind", "target", "requested", "observed", "failure"], "properties": {"id": {"type": "integer"}, "state": {"type": "string", "enum": ["pending", "confirmed", "failed"]}, "kind": {"type": "string", "enum": ["volume", "autoDark", "parameter", "outputToggle", "other"]}, "target": {"$ref": "#/components/schemas/Target"}, "address": {"type": "integer", "description": "Only present for kind=parameter"}, "index": {"type": "integer", "description": "Only present for kind=parameter"}, "requested": {"type": "integer"}, "observed": {"type": "integer", "nullable": true, "description": "New activeOutputCode for kind=outputToggle"}, "failure": {"type": "string", "nullable": true, "enum": ["dac_mismatch", "response_timeout", "usb_failed", "disconnected"]}}},
      "IrReceipt": {"type": "object", "required": ["sent", "confirmed", "model", "modelSource", "action"], "properties": {"sent": {"type": "boolean"}, "confirmed": {"type": "boolean", "enum": [false]}, "model": {"type": "integer"}, "modelSource": {"type": "integer"}, "action": {"type": "string", "enum": ["on", "off"]}}},
      "Event": {"type": "object", "required": ["sequence", "boot", "uptime", "time", "kind", "detail", "repeats"], "properties": {"sequence": {"type": "integer"}, "boot": {"type": "integer"}, "uptime": {"type": "integer"}, "time": {"type": "integer", "description": "UTC Unix seconds, or 0 before SNTP synchronization"}, "kind": {"type": "integer", "minimum": 1, "maximum": 24}, "detail": {"type": "integer"}, "repeats": {"type": "integer"}}},
      "Events": {"type": "object", "required": ["capacity", "boot", "events"], "properties": {"capacity": {"type": "integer"}, "boot": {"type": "integer"}, "events": {"type": "array", "items": {"$ref": "#/components/schemas/Event"}}}}
    }
  }
}
